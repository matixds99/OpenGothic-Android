   for(auto& i:code) {
     if(i.op()!=spv::OpSource)
       continue;
+    if(i.length()>4) {
+      // glslang puts `// OpModuleProcessed define-macro NAME[=VALUE]` lines first in the text of the source
+      const char*  text  = reinterpret_cast<const char*>(&i[4]);
+      const size_t limit = (i.length()-4)*4;
+      const std::string_view all(text, strnlen(text, limit));
+      const std::string_view tag = "define-macro ";
+      for(size_t at=all.find(tag); at!=std::string_view::npos && at<4096; at=all.find(tag, at)) {
+        at += tag.size();
+        const size_t end = all.find('\n', at);
+        if(!dbg.defines.empty())
+          dbg.defines += ' ';
+        dbg.defines.append(all.substr(at, end==std::string_view::npos ? std::string_view::npos : end-at));
+        }
+      }
+
     uint32_t src = i.length()>3 ? i[3] : 0;
     if(src==0)
       continue;
